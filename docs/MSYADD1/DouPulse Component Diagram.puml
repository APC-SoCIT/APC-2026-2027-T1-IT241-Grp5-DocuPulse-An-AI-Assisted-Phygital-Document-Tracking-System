@startuml DocuPulse-Component
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

Container(web_portal, "Web Portal", "React + Vite, hosted on Vercel", "Single-page application used to submit, track, review, and act on requisitions.")

Container(auth_service, "Auth Service", "Supabase Auth", "Authentication and role-based access control.")
Container(notification_service, "Notification Service", "Supabase Realtime / Edge Functions", "Pushes real-time status updates to users.")
ContainerDb(requisition_db, "Requisition Database", "Supabase (PostgreSQL)", "Requisitions, approval history, statuses, user roles, audit logs.")

System_Ext(ai_system, "AI System", "External AI service that analyzes and routes requisitions.")

Container_Boundary(api, "Requisition API (Node.js, Vercel Serverless Functions)") {
    Component(auth_middleware, "Auth Middleware", "Express middleware", "Validates the user's token and enforces role-based access on every request.")

    Component(requisition_controller, "Requisition Controller", "REST controller", "Create, submit, list, and track requisitions.")
    Component(approval_controller, "Approval Controller", "REST controller", "Review, endorse, approve, or disapprove with a reason.")
    Component(logistics_controller, "Logistics Controller", "REST controller", "Process approved requisitions and manage reports.")

    Component(requisition_service, "Requisition Service", "Business logic", "Creates requisitions, generates the requisition record, and tracks status.")
    Component(approval_workflow, "Approval Workflow Service", "Business logic", "Runs the approval chain across Department Head, Academic Services, Finance, and Executive Director; handles disapproval reasons.")
    Component(fulfillment_service, "Fulfillment and Report Service", "Business logic", "Processes fulfillment/delivery and builds reports.")
    Component(ai_routing_client, "AI Routing Client", "HTTP client", "Sends requisitions to the AI System and applies the routing recommendation.")

    Component(notification_publisher, "Notification Publisher", "Event emitter", "Emits status update events on every requisition state change.")
    Component(requisition_repository, "Requisition Repository", "Supabase client library", "Data access for requisitions, approvals, and audit logs.")
}

Rel(web_portal, auth_middleware, "Makes API calls to", "JSON/HTTPS")
Rel(auth_middleware, auth_service, "Validates tokens with", "HTTPS")

Rel(auth_middleware, requisition_controller, "Forwards authenticated requests to")
Rel(auth_middleware, approval_controller, "Forwards authenticated requests to")
Rel(auth_middleware, logistics_controller, "Forwards authenticated requests to")

Rel(requisition_controller, requisition_service, "Uses")
Rel(approval_controller, approval_workflow, "Uses")
Rel(logistics_controller, fulfillment_service, "Uses")

Rel(requisition_service, ai_routing_client, "Requests routing for submitted requisitions")
Rel(ai_routing_client, ai_system, "Sends requisitions for analysis and routing", "API Calls")

Rel(requisition_service, notification_publisher, "Emits status events")
Rel(approval_workflow, notification_publisher, "Emits status events")
Rel(fulfillment_service, notification_publisher, "Emits status events")

Rel(requisition_service, requisition_repository, "Reads and writes requisitions via")
Rel(approval_workflow, requisition_repository, "Reads and writes approvals via")
Rel(fulfillment_service, requisition_repository, "Reads and writes fulfillment data via")

Rel(notification_publisher, notification_service, "Triggers status update events to", "Internal API / Realtime Channel")
Rel(requisition_repository, requisition_db, "Reads from and writes to", "SQL/TCP")

@enduml