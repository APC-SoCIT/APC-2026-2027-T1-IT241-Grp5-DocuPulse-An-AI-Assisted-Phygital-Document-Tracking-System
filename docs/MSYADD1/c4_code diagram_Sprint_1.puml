@startuml DocuPulse_C4_Code_Sprint1
title DocuPulse - C4 Code Diagram (Level 4)

top to bottom direction
hide circle
hide empty members
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam linetype polyline
skinparam nodesep 45
skinparam ranksep 90
skinparam roundCorner 12
skinparam wrapWidth 220

skinparam ArrowColor #707070
skinparam ArrowFontColor #505050
skinparam ArrowFontSize 10
skinparam ArrowThickness 1

skinparam titleFontColor #444444
skinparam titleFontSize 16

skinparam rectangle<<boundary>> {
  BackgroundColor transparent
  BorderColor #444444
  BorderStyle dashed
  FontColor #444444
  FontSize 13
  StereotypeFontColor transparent
  StereotypeFontSize 1
}

skinparam class {
  FontColor #FFFFFF
  AttributeFontColor #FFFFFF
  StereotypeFontColor #FFFFFF
  StereotypeFontSize 10
  AttributeFontSize 11
  FontSize 13
  BorderThickness 1

  BackgroundColor<<controller>> #1168BD
  BorderColor<<controller>> #3C7FC0
  BackgroundColor<<service>> #1168BD
  BorderColor<<service>> #3C7FC0
  BackgroundColor<<guard>> #1168BD
  BorderColor<<guard>> #3C7FC0

  BackgroundColor<<adapter>> #999999
  BorderColor<<adapter>> #8A8A8A

  BackgroundColor<<entity>> #08427B
  BorderColor<<entity>> #073B6F
  BackgroundColor<<enumeration>> #08427B
  BorderColor<<enumeration>> #073B6F
  BackgroundColor<<dto>> #08427B
  BorderColor<<dto>> #073B6F
}

' ============================================================
' LAYER 1 - Controllers (guards on the left, next to AuthService)
' ============================================================
rectangle "Controllers Layer" <<boundary>> as L1 {
  class JwtAuthGuard <<guard>> {
    +canActivate(ctx: ExecutionContext): boolean
  }

  class RolesGuard <<guard>> {
    +canActivate(ctx: ExecutionContext): boolean
  }

  class AuthController <<controller>> {
    +register(dto: RegisterDto): Promise<AuthResponse>
    +login(dto: LoginDto): Promise<AuthResponse>
  }

  class RequisitionController <<controller>> {
    +createRequisition(dto: CreateRequisitionDto, files: File[]): Promise<Requisition>
    +getRequisitionById(id: string): Promise<Requisition>
    +getUserRequisitions(userId: string, filter?: RequisitionFilterDto): Promise<Requisition[]>
    +getRequisitionStatus(id: string): Promise<RequisitionStatusResponse>
    +getApprovalChain(requisitionId: string): Promise<ApprovalChainResponse>
  }

  class TrackingController <<controller>> {
    +scanQRCode(dto: ScanQRCodeDto): Promise<TrackingLog>
    +getRequisitionTrackingHistory(requisitionId: string): Promise<TrackingLog[]>
  }

  class NotificationController <<controller>> {
    +getMyNotifications(userId: string): Promise<Notification[]>
    +markAsRead(notificationId: string): Promise<void>
  }
}

' ============================================================
' LAYER 2 - Services (same left-to-right order as their controllers)
' ============================================================
rectangle "Services / Domain Logic Layer" <<boundary>> as L2 {
  class AuthService <<service>> {
    +validateUserCredentials(credentials: Credentials): Promise<User>
    +assignDefaultDepartmentRole(user: User, deptId: string): Promise<Role>
  }

  class RequisitionService <<service>> {
    +validateFormCompleteness(dto: CreateRequisitionDto): ValidationResult
    +checkDuplicateSubmission(dto: CreateRequisitionDto): Promise<boolean>
    +generateUniqueRequisitionId(): string
    +generateQRCode(requisitionId: string): Promise<string>
    +createRequisitionRecord(data: CreateRequisitionDto): Promise<Requisition>
    +attachSupportingDocuments(requisitionId: string, files: File[]): Promise<Document[]>
    +searchUserRequisitions(userId: string, filter: RequisitionFilterDto): Promise<Requisition[]>
  }

  class WorkflowTrackingService <<service>> {
    +initiateApprovalChain(requisitionId: string): Promise<ApprovalStage[]>
    +getApprovalChain(requisitionId: string): Promise<ApprovalStage[]>
    +processQRScan(qrPayload: string, location: string, userId: string): Promise<TrackingLog>
    +updateWorkflowStage(requisitionId: string, nextStage: Stage): Promise<void>
  }

  class NotificationService <<service>> {
    +notifyDepartmentHead(deptId: string, requisitionId: string): Promise<void>
    +getNotificationHistory(userId: string): Promise<Notification[]>
  }
}

' ============================================================
' DTOs - kept in their own box beside the services, not inside them
' ============================================================
rectangle "DTOs (key ones)" <<boundary>> as LD {
  class RegisterDto <<dto>> {
    +email: string
    +password: string
    +fullName: string
    +departmentId: string
    +acceptedTerms: boolean
  }

  class CreateRequisitionDto <<dto>> {
    +title: string
    +departmentId: string
    +description: string
    +amount: number
  }

  class ScanQRCodeDto <<dto>> {
    +qrPayload: string
    +locationName: string
  }

  class RequisitionFilterDto <<dto>> {
    +search?: string
    +status?: RequisitionStatus
    +dateFrom?: DateTime
    +dateTo?: DateTime
  }
}

' ============================================================
' LAYER 3 - Infrastructure (ordered under the services that use them)
' ============================================================
rectangle "Infrastructure / Adapters" <<boundary>> as L3 {
  class StorageAdapter <<adapter>> {
    +uploadFiles(files: File[]): Promise<string[]>
  }

  class SupabaseRepository <<adapter>> {
    +saveEntity<T>(entity: T): Promise<T>
    +findEntityById<T>(id: string): Promise<T>
    +queryEntities<T>(query: Object): Promise<T[]>
  }

  class StatusRealtimeGateway <<adapter>> {
    +publishStatusChange(requisitionId: string, stage: Stage): void
  }

  class NotificationAdapter <<adapter>> {
    +sendStageChangeNotification(targetUserId: string, message: string): Promise<void>
  }
}

' ============================================================
' LAYER 4 - Entities & enumerations (bottom, in their own rows)
' ============================================================
rectangle "Entities & Models" <<boundary>> as L4 {
  class Department <<entity>> {
    +id: string
    +name: string
  }

  class User <<entity>> {
    +id: string
    +email: string
    +fullName: string
    +department: Department
    +role: Role
  }

  class Requisition <<entity>> {
    +id: string
    +requestorId: string
    +qrCode: string
    +status: RequisitionStatus
    +currentStage: Stage
    +currentDepartment: Department
    +createdAt: DateTime
    +updatedAt: DateTime
  }

  class Notification <<entity>> {
    +id: string
    +requisitionId: string
    +userId: string
    +stage: Stage
    +message: string
    +isRead: boolean
    +createdAt: DateTime
  }

  class ApprovalStage <<entity>> {
    +id: string
    +requisitionId: string
    +requiredRole: Role
    +status: ApprovalStatus
    +approverId: string
    +actedAt: DateTime
  }

  class Document <<entity>> {
    +id: string
    +requisitionId: string
    +fileName: string
    +fileUrl: string
    +fileType: string
    +uploadedAt: DateTime
  }

  class TrackingLog <<entity>> {
    +id: string
    +requisitionId: string
    +scannedByUserId: string
    +locationName: string
    +stage: Stage
    +timestamp: DateTime
  }
}

rectangle "Enumerations" <<boundary>> as L5 {
  enum Role <<enumeration>> {
    REQUESTOR
    DEPARTMENT_HEAD
    LIBRARIAN
    FINANCE_OFFICER
    LOGISTICS_STAFF
    ADMIN
  }

  enum RequisitionStatus <<enumeration>> {
    SUBMITTED
    IN_REVIEW
    APPROVED
    REJECTED
  }

  enum ApprovalStatus <<enumeration>> {
    PENDING
    APPROVED
    REJECTED
  }

  enum Stage <<enumeration>> {
    DEPARTMENT_HEAD
    FINANCE
    LOGISTICS
  }
}

' ===================== Layer relationships ==================
' Controllers -> Services
AuthController --> AuthService : Delegates auth\n[DP-00]
RequisitionController --> RequisitionService : Submits / retrieves\n[DP-01 to DP-04]
RequisitionController --> WorkflowTrackingService : Status + approval chain\n[DP-05, DP-06]
TrackingController --> WorkflowTrackingService : Processes QR scans\n[DP-07]
NotificationController --> NotificationService : Reads history\n[DP-08]
JwtAuthGuard ..> AuthService : Verifies identity
RolesGuard ..> AuthService : Checks role

' Controllers -> DTOs
AuthController ..> RegisterDto : Validates
RequisitionController ..> CreateRequisitionDto : Accepts
RequisitionController ..> RequisitionFilterDto : Filters with
TrackingController ..> ScanQRCodeDto : Accepts

' Service -> Service
RequisitionService ..> WorkflowTrackingService : Triggers approval chain\n[on creation]
RequisitionService ..> NotificationService : Notifies Dept Head\n[on submit]
WorkflowTrackingService --> NotificationService : Stage-change notices

' Services -> Infrastructure
RequisitionService --> StorageAdapter : Uploads attachments\n[DP-03]
AuthService --> SupabaseRepository : User records
RequisitionService --> SupabaseRepository : Requisitions + documents
WorkflowTrackingService --> SupabaseRepository : Scans + stage changes\n[DP-07]
NotificationService --> SupabaseRepository : Notification history
WorkflowTrackingService --> StatusRealtimeGateway : Status updates\n[DP-05]
NotificationService --> NotificationAdapter : Dispatches\n[DP-08]

' ---- layout hints (invisible) : row order inside each layer ----
JwtAuthGuard -[hidden]right-> RolesGuard
RolesGuard -[hidden]right-> AuthController
AuthController -[hidden]right-> RequisitionController
RequisitionController -[hidden]right-> TrackingController
TrackingController -[hidden]right-> NotificationController

AuthService -[hidden]right-> RequisitionService
RequisitionService -[hidden]right-> WorkflowTrackingService
WorkflowTrackingService -[hidden]right-> NotificationService
NotificationService -[hidden]right-> RegisterDto

RegisterDto -[hidden]right-> CreateRequisitionDto
CreateRequisitionDto -[hidden]down-> ScanQRCodeDto
ScanQRCodeDto -[hidden]right-> RequisitionFilterDto

StorageAdapter -[hidden]right-> SupabaseRepository
SupabaseRepository -[hidden]right-> StatusRealtimeGateway
StatusRealtimeGateway -[hidden]right-> NotificationAdapter

' ---- layer order (top -> bottom) ----
RolesGuard -[hidden]down-> AuthService
SupabaseRepository -[hidden]down-> User
Department -[hidden]right-> User
User -[hidden]right-> Requisition
Notification -[hidden]right-> ApprovalStage
ApprovalStage -[hidden]right-> Document
Document -[hidden]right-> TrackingLog
Role -[hidden]right-> RequisitionStatus
RequisitionStatus -[hidden]right-> ApprovalStatus
ApprovalStatus -[hidden]right-> Stage
Requisition -[hidden]down-> Document
TrackingLog -[hidden]down-> Role

' ===================== Entity relationships =================
Department "1" -right- "many" User : has
User "1" -right- "many" Requisition : submits
User "1" -down- "many" Notification : receives
Requisition "1" *-down- "many" ApprovalStage : defines
Requisition "1" *-down- "many" Document : has
Requisition "1" *-down- "many" TrackingLog : contains
Requisition "1" -down- "many" Notification : triggers

@enduml