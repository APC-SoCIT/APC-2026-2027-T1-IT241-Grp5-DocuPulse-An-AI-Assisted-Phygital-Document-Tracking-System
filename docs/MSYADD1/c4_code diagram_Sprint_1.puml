@startuml DocuPulse_C4_Code_Sprint1
title C4 Code Diagram (Level 4)

top to bottom direction
hide circle
hide empty members
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam nodesep 40
skinparam ranksep 60
skinparam roundCorner 12

skinparam ArrowColor #707070
skinparam ArrowFontColor #707070
skinparam ArrowFontSize 10
skinparam ArrowThickness 1

skinparam titleFontColor #444444
skinparam titleFontSize 14

skinparam rectangle<<boundary>> {
  BackgroundColor transparent
  BorderColor #444444
  BorderStyle dashed
  FontColor #444444
  FontSize 13
  StereotypeFontColor white
  StereotypeFontSize 1
}

skinparam class {
  FontColor #FFFFFF
  AttributeFontColor #FFFFFF
  StereotypeFontColor #FFFFFF
  StereotypeFontSize 10
  AttributeFontSize 11
  FontSize 13
  BorderThickness 1

  ' components (controllers, services, guards) - same blue as the system box
  BackgroundColor<<controller>> #1168BD
  BorderColor<<controller>> #3C7FC0
  BackgroundColor<<service>> #1168BD
  BorderColor<<service>> #3C7FC0
  BackgroundColor<<guard>> #1168BD
  BorderColor<<guard>> #3C7FC0

  ' infrastructure / external-facing adapters - same grey as the external system box
  BackgroundColor<<adapter>> #999999
  BorderColor<<adapter>> #8A8A8A

  ' entities, enums, DTOs - same dark blue as the person boxes
  BackgroundColor<<entity>> #08427B
  BorderColor<<entity>> #073B6F
  BackgroundColor<<enumeration>> #08427B
  BorderColor<<enumeration>> #073B6F
  BackgroundColor<<dto>> #08427B
  BorderColor<<dto>> #073B6F
}

' ============================================================
rectangle "Controllers Layer" <<boundary>> {
  class AuthController <<controller>> {
    +register(dto: RegisterDto): Promise<AuthResponse>
    +login(dto: LoginDto): Promise<AuthResponse>
  }

  class RequisitionController <<controller>> {
    +createRequisition(dto: CreateRequisitionDto, files: File[]): Promise<Requisition>
    +getRequisitionById(id: string): Promise<Requisition>
    +getUserRequisitions(userId: string, filter?: RequisitionFilterDto): Promise<Requisition[]>
    +getRequisitionStatus(id: string): Promise<RequisitionStatusResponse>
    +getApprovalChain(requisitionId: string): Promise<ApprovalChainResponse>
  }

  class TrackingController <<controller>> {
    +scanQRCode(dto: ScanQRCodeDto): Promise<TrackingLog>
    +getRequisitionTrackingHistory(requisitionId: string): Promise<TrackingLog[]>
  }

  class NotificationController <<controller>> {
    +getMyNotifications(userId: string): Promise<Notification[]>
    +markAsRead(notificationId: string): Promise<void>
  }

  class JwtAuthGuard <<guard>> {
    +canActivate(ctx: ExecutionContext): boolean
  }

  class RolesGuard <<guard>> {
    +canActivate(ctx: ExecutionContext): boolean
  }
}

' ============================================================
rectangle "Services / Domain Logic Layer" <<boundary>> {
  class AuthService <<service>> {
    +validateUserCredentials(credentials: Credentials): Promise<User>
    +assignDefaultDepartmentRole(user: User, deptId: string): Promise<Role>
  }

  class RequisitionService <<service>> {
    +validateFormCompleteness(dto: CreateRequisitionDto): ValidationResult
    +checkDuplicateSubmission(dto: CreateRequisitionDto): Promise<boolean>
    +generateUniqueRequisitionId(): string
    +generateQRCode(requisitionId: string): Promise<string>
    +createRequisitionRecord(data: CreateRequisitionDto): Promise<Requisition>
    +attachSupportingDocuments(requisitionId: string, files: File[]): Promise<Document[]>
    +searchUserRequisitions(userId: string, filter: RequisitionFilterDto): Promise<Requisition[]>
  }

  class WorkflowTrackingService <<service>> {
    +initiateApprovalChain(requisitionId: string): Promise<ApprovalStage[]>
    +getApprovalChain(requisitionId: string): Promise<ApprovalStage[]>
    +processQRScan(qrPayload: string, location: string, userId: string): Promise<TrackingLog>
    +updateWorkflowStage(requisitionId: string, nextStage: Stage): Promise<void>
  }

  class NotificationService <<service>> {
    +notifyDepartmentHead(deptId: string, requisitionId: string): Promise<void>
    +getNotificationHistory(userId: string): Promise<Notification[]>
  }
}

' ============================================================
rectangle "Infrastructure / Adapters" <<boundary>> {
  class SupabaseRepository <<adapter>> {
    +saveEntity<T>(entity: T): Promise<T>
    +findEntityById<T>(id: string): Promise<T>
    +queryEntities<T>(query: Object): Promise<T[]>
  }

  class StorageAdapter <<adapter>> {
    +uploadFiles(files: File[]): Promise<string[]>
  }

  class NotificationAdapter <<adapter>> {
    +sendStageChangeNotification(targetUserId: string, message: string): Promise<void>
  }

  class StatusRealtimeGateway <<adapter>> {
    +publishStatusChange(requisitionId: string, stage: Stage): void
  }
}

' ============================================================
rectangle "Entities & Models" <<boundary>> {
  class User <<entity>> {
    +id: string
    +email: string
    +fullName: string
    +department: Department
    +role: Role
  }

  class Requisition <<entity>> {
    +id: string
    +requestorId: string
    +qrCode: string
    +status: RequisitionStatus
    +currentStage: Stage
    +currentDepartment: Department
    +createdAt: DateTime
    +updatedAt: DateTime
  }

  class Document <<entity>> {
    +id: string
    +requisitionId: string
    +fileName: string
    +fileUrl: string
    +fileType: string
    +uploadedAt: DateTime
  }

  class TrackingLog <<entity>> {
    +id: string
    +requisitionId: string
    +scannedByUserId: string
    +locationName: string
    +stage: Stage
    +timestamp: DateTime
  }

  class ApprovalStage <<entity>> {
    +id: string
    +requisitionId: string
    +requiredRole: Role
    +status: ApprovalStatus
    +approverId: string
    +actedAt: DateTime
  }

  class Notification <<entity>> {
    +id: string
    +requisitionId: string
    +userId: string
    +stage: Stage
    +message: string
    +isRead: boolean
    +createdAt: DateTime
  }

  enum Role <<enumeration>> {
    REQUESTOR
    DEPARTMENT_HEAD
    LIBRARIAN
    FINANCE_OFFICER
    LOGISTICS_STAFF
    ADMIN
  }

  enum RequisitionStatus <<enumeration>> {
    SUBMITTED
    IN_REVIEW
    APPROVED
    REJECTED
  }

  enum ApprovalStatus <<enumeration>> {
    PENDING
    APPROVED
    REJECTED
  }

  enum Stage <<enumeration>> {
    DEPARTMENT_HEAD
    FINANCE
    LOGISTICS
  }
}

' ============================================================
rectangle "DTOs (key ones)" <<boundary>> {
  class RegisterDto <<dto>> {
    +email: string
    +password: string
    +fullName: string
    +departmentId: string
    +acceptedTerms: boolean
  }

  class RequisitionFilterDto <<dto>> {
    +search?: string
    +status?: RequisitionStatus
    +dateFrom?: DateTime
    +dateTo?: DateTime
  }
}

' ===================== Layer relationships ==================
AuthController ..> RegisterDto : <b>Validates</b>
AuthController --> AuthService : <b>Delegates auth logic</b>\n<i>[DP-00]</i>
RequisitionController --> RequisitionService : <b>Submits and retrieves</b>\n<i>[DP-01 to DP-04]</i>
RequisitionController --> WorkflowTrackingService : <b>Reads status and approval chain</b>\n<i>[DP-05, DP-06]</i>
RequisitionController ..> RequisitionFilterDto : <b>Filters with</b>
TrackingController --> WorkflowTrackingService : <b>Processes QR scans</b>\n<i>[DP-07]</i>
NotificationController --> NotificationService : <b>Reads history</b>\n<i>[DP-08]</i>
JwtAuthGuard ..> AuthService : <b>Verifies identity</b>
RolesGuard ..> AuthService : <b>Checks role</b>

RequisitionService ..> WorkflowTrackingService : <b>Triggers approval chain</b>\n<i>[on creation]</i>
RequisitionService ..> NotificationService : <b>Notifies Dept Head</b>\n<i>[on submit]</i>
WorkflowTrackingService --> NotificationService : <b>Sends stage-change notices</b>
NotificationService --> NotificationAdapter : <b>Dispatches</b>\n<i>[DP-08]</i>
WorkflowTrackingService --> StatusRealtimeGateway : <b>Pushes status updates</b>\n<i>[DP-05]</i>

AuthService --> SupabaseRepository : <b>Manages user records</b>
RequisitionService --> SupabaseRepository : <b>Persists requisitions and documents</b>
RequisitionService --> StorageAdapter : <b>Uploads attachments</b>\n<i>[DP-03]</i>
WorkflowTrackingService --> SupabaseRepository : <b>Logs scans and stage changes</b>\n<i>[DP-07]</i>
NotificationService --> SupabaseRepository : <b>Stores notification history</b>

' ---- layout hints (invisible) ----
AuthController -[hidden]right-> RequisitionController
RequisitionController -[hidden]right-> TrackingController
TrackingController -[hidden]right-> NotificationController
JwtAuthGuard -[hidden]right-> RolesGuard
AuthService -[hidden]right-> RequisitionService
RequisitionService -[hidden]right-> WorkflowTrackingService
WorkflowTrackingService -[hidden]right-> NotificationService
SupabaseRepository -[hidden]right-> StorageAdapter
StorageAdapter -[hidden]right-> NotificationAdapter
NotificationAdapter -[hidden]right-> StatusRealtimeGateway
RegisterDto -[hidden]right-> RequisitionFilterDto

' ===================== Entity relationships =================
User "1" -- "many" Requisition : <b>submits</b>
User "1" -- "many" Notification : <b>receives</b>
Requisition "1" *-- "many" Document : <b>has</b>
Requisition "1" *-- "many" TrackingLog : <b>contains</b>
Requisition "1" *-- "many" ApprovalStage : <b>defines</b>
Requisition "1" -- "many" Notification : <b>triggers</b>

@enduml