@startuml DocuPulse_C4_Code_Sprint1
title C4 Code Diagram (Level 4) - DocuPulse (Sprint 1 Scope)

top to bottom direction
hide empty members
skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 110
skinparam ranksep 100
skinparam wrapWidth 700
skinparam maxMessageSize 160

skinparam ArrowColor #444444
skinparam ArrowFontColor #222222
skinparam ArrowFontSize 11
skinparam titleFontSize 16
skinparam packageBorderColor #555555
skinparam packageBackgroundColor #FFFFFF
skinparam packageFontSize 13
skinparam classBackgroundColor #F8F8F8
skinparam classBorderColor #555555
skinparam classFontSize 13
skinparam classAttributeFontSize 11

' ============================================================
package "Controllers Layer" as CTL {
  class AuthController {
    +register(dto: RegisterDto): Promise<AuthResponse>
    +login(dto: LoginDto): Promise<AuthResponse>
  }

  class RequisitionController {
    +createRequisition(dto: CreateRequisitionDto, files: File[]): Promise<Requisition>
    +getRequisitionById(id: string): Promise<Requisition>
    +getUserRequisitions(userId: string): Promise<Requisition[]>
    +getRequisitionStatus(id: string): Promise<RequisitionStatusResponse>
    +getApprovalChain(requisitionId: string): Promise<ApprovalChainResponse>
  }

  class TrackingController {
    +scanQRCode(dto: ScanQRCodeDto): Promise<TrackingLog>
    +getRequisitionTrackingHistory(requisitionId: string): Promise<TrackingLog[]>
  }
}

' ============================================================
package "Services / Domain Logic Layer" as SVC {
  class AuthService {
    +validateUserCredentials(credentials: Credentials): Promise<User>
    +assignDefaultDepartmentRole(user: User, deptId: string): Promise<Role>
  }

  class RequisitionService {
    +validateFormCompleteness(dto: CreateRequisitionDto): ValidationResult
    +checkDuplicateSubmission(dto: CreateRequisitionDto): Promise<boolean>
    +generateUniqueRequisitionId(): string
    +createRequisitionRecord(data: CreateRequisitionDto): Promise<Requisition>
    +attachSupportingDocuments(requisitionId: string, files: File[]): Promise<Document[]>
  }

  class WorkflowTrackingService {
    +initiateApprovalChain(requisitionId: string): Promise<ApprovalStage[]>
    +processQRScan(qrPayload: string, location: string, userId: string): Promise<TrackingLog>
    +updateWorkflowStage(requisitionId: string, nextStage: Stage): Promise<void>
    +notifyDepartmentHead(deptId: string, requisitionId: string): Promise<void>
  }
}

' ============================================================
package "Infrastructure / Adapters" as INF {
  class StorageAdapter {
    +uploadFiles(files: File[]): Promise<string[]>
  }

  class NotificationAdapter {
    +sendStageChangeNotification(targetUserId: string, message: string): Promise<void>
  }

  class SupabaseRepository {
    +saveEntity<T>(entity: T): Promise<T>
    +findEntityById<T>(id: string): Promise<T>
    +queryEntities<T>(query: Object): Promise<T[]>
  }
}

' ============================================================
package "Entities & Models" as ENT {
  class User {
    +id: string
    +email: string
    +fullName: string
    +department: Department
    +role: Role
  }

  class Requisition {
    +id: string
    +requestorId: string
    +status: RequisitionStatus
    +createdAt: DateTime
    +updatedAt: DateTime
  }

  class TrackingLog {
    +id: string
    +requisitionId: string
    +scannedByUserId: string
    +locationName: string
    +timestamp: DateTime
    +stageName: string
  }

  class ApprovalStage {
    +id: string
    +requisitionId: string
    +requiredRole: DepartmentRole
    +status: ApprovalStatus
    +updatedTime: DateTime
  }
}

' ===================== Controllers -> Services ==============
AuthController -down-> AuthService : delegates auth logic
RequisitionController -down-> RequisitionService : delegates submission\n& retrieval
RequisitionController -down-> WorkflowTrackingService : queries approval\nchain
TrackingController -down-> WorkflowTrackingService : processes QR\nscans & logs

' ===================== Service -> Service ===================
RequisitionService .right.> WorkflowTrackingService : triggers approval chain\non creation

' ===================== Services -> Infrastructure ===========
AuthService -down-> SupabaseRepository : manages user\nidentity records
RequisitionService -down-> SupabaseRepository : persists requisition\nrecords
RequisitionService -down-> StorageAdapter : uploads DP-03\nattachments
WorkflowTrackingService -down-> SupabaseRepository : logs DP-07 QR scans\n& status updates
WorkflowTrackingService -down-> NotificationAdapter : dispatches DP-08\nnotifications

' ===================== Entity relationships =================
User "1" -right- "many" Requisition : submits
Requisition "1" -right- "many" TrackingLog : contains
Requisition "1" -down- "many" ApprovalStage : defines

' ---- layout hints: same left-to-right order in every row ----
RequisitionController -[hidden]left- AuthController
RequisitionController -[hidden]right- TrackingController
AuthController -[hidden]left- RequisitionController
RequisitionService -[hidden]left- AuthService
RequisitionService -[hidden]right- WorkflowTrackingService
StorageAdapter -[hidden]right- NotificationAdapter
StorageAdapter -[hidden]down- SupabaseRepository
SupabaseRepository -[hidden]down- User

@enduml
