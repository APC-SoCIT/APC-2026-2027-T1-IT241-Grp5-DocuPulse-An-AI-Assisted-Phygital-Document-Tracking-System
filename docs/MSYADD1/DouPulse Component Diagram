@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

' --- LAYOUT & STYLING SETTINGS ---
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 50
skinparam packageStyle rectangle
skinparam WrapWidth 180

title Component Diagram - DocuPulse Backend API (Level 3)

' --- EXTERNAL CONTAINERS (Simplified Top & Bottom Anchors) ---
Container(web_portal, "Web Portal", "React + Vite", "Single entry point for all API requests")
Container(auth_service, "Auth Service", "Supabase Auth", "Validates user JWT tokens")

' --- CONTAINER BOUNDARY: BACKEND API ---
Container_Boundary(requisition_api, "Requisition API (Node.js REST API)") {
    
    ' Layer 1: Entry Controller & Auth
    Component(req_controller, "Requisition Controller", "Express Router", "Exposes REST endpoints")
    Component(auth_middleware, "Auth Middleware", "Express Middleware", "Validates tokens & enforces RBAC")
    
    ' Layer 2: Core Domain Logic
    Component(req_service, "Requisition Service", "Node.js Module", "Core business logic for submissions")
    Component(approval_workflow, "Approval Workflow Component", "Node.js Module", "Manages approve/endorse sequence")
    Component(req_processing, "Requisition Processing Component", "Node.js Module", "Handles Logistics fulfillment")
    Component(ai_routing, "AI Routing Component", "Node.js Module", "Formats AI payload & handles routing logic")
    
    ' Layer 3: Data Access & Events
    Component(data_access, "Data Access Layer", "Supabase Client", "Handles database operations")
    Component(notification_trigger, "Notification Trigger", "Node.js Module", "Publishes status change events")
}

' --- EXTERNAL INFRASTRUCTURE & SERVICES ---
ContainerDb(db, "Requisition Database", "Supabase PostgreSQL", "Stores requests & audit logs")
Container(notification_svc, "Notification Service", "Supabase Realtime", "Pushes WebSocket notifications")
System_Ext(ai_system, "External AI System", "Performs anomaly detection & smart routing")

' --- LAYOUT ALIGNMENT HINTS (Forces Linear Hierarchy) ---
web_portal -[hidden]down-> req_controller
req_controller -[hidden]down-> req_service
req_service -[hidden]down-> data_access
data_access -[hidden]down-> db

' --- RELATIONSHIP ARROWS ---
' 1. Entry point
Rel_D(web_portal, req_controller, "HTTPS / REST API")
Rel_R(req_controller, auth_middleware, "Passes request")
Rel_U(auth_middleware, auth_service, "Validates JWT", "HTTPS")

' 2. Controller routing to services
Rel_D(req_controller, req_service, "Directs create/view")
Rel_D(req_controller, approval_workflow, "Directs approvals")
Rel_D(req_controller, req_processing, "Directs fulfillment")

' 3. Domain Logic connections
Rel_R(approval_workflow, ai_routing, "Requests evaluation")
Rel_R(ai_routing, ai_system, "Sends payload", "JSON API")

' 4. Data & Notification Triggers
Rel_D(req_service, data_access, "Reads/Writes")
Rel_D(approval_workflow, data_access, "Updates status")
Rel_D(req_processing, data_access, "Logs processing")

Rel_R(approval_workflow, notification_trigger, "Triggers event")
Rel_R(req_processing, notification_trigger, "Triggers event")

' 5. External DB & Realtime Outputs
Rel_D(data_access, db, "SQL Queries", "TCP")
Rel_D(notification_trigger, notification_svc, "Publishes event")
Rel_U(notification_svc, web_portal, "Pushes updates", "WebSocket")

@enduml