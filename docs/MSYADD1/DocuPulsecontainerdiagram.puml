@startuml DocuPulse_C4_Container
!include <C4/C4_Container>

Person(requestor, "Requestor", "Creates and tracks requisitions, receives notifications.")
Person(depthead, "Department Head", "Reviews, endorses, and approves requisitions.")
Person(exec, "Executive Director", "Grants final approval.")
Person(acad, "Academic Services", "Approves from an academic services standpoint.")
Person(finance, "Finance", "Approves from a budget/finance standpoint.")
Person(logistics, "Logistics", "Manages reports and processes requisitions.")

Lay_R(requestor, depthead)
Lay_R(depthead, exec)
Lay_R(exec, acad)
Lay_R(acad, finance)
Lay_R(finance, logistics)

System_Boundary(docupulse, "Requisition Management System") {
    Container(auth, "Auth Service", "Supabase Auth", "User authentication and role-based access control.")
    Container(web, "Web Portal", "React + Vite, hosted on Vercel", "Single-page app to submit, track, review, and act on requisitions.")
    Container(api, "Requisition API", "Node.js, REST, Vercel Serverless Functions", "Requisition creation, approval routing, disapproval, processing, reports, and status updates.")
    Container(notif, "Notification Service", "Supabase Realtime / Edge Functions", "Pushes live status updates to users and forwards them to LIRA.")
    ContainerDb(db, "Requisition Database", "Supabase (PostgreSQL)", "Requisitions, approval history, statuses, user roles, audit logs.")
}

System_Ext(ai, "AI System", "Analyzes requisitions and routes them to the appropriate approver.")
System_Ext(lira, "LIRA System", "Receives requisition status notifications.")

Rel_D(requestor, web, "Creates and tracks", "HTTPS")
Rel_D(depthead, web, "Reviews and approves", "HTTPS")
Rel_D(exec, web, "Gives final approval", "HTTPS")
Rel_D(acad, web, "Reviews and approves", "HTTPS")
Rel_D(finance, web, "Reviews and approves", "HTTPS")
Rel_D(logistics, web, "Processes, reports", "HTTPS")

Rel_L(web, auth, "Authenticates via", "HTTPS")
Rel_D(web, api, "Calls", "JSON/HTTPS")
Rel_R(api, notif, "Triggers status events", "Realtime channel")
Rel_U(notif, web, "Pushes live updates", "WebSocket")

Rel_D(auth, db, "Stores identities", "SQL")
Rel_D(api, db, "Reads and writes", "SQL")

BiRel_D(api, ai, "Sends requisitions, gets routing", "API Calls")
Rel_R(notif, lira, "Sends status notifications", "API Calls")

@enduml