@startuml DocuPulse-Container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

Person(requestor, "Requestor", "Creates and manages requisitions, and receives notifications of status.")
Person(dept_head, "Department Head", "Reviews, endorses, and approves submitted requisitions.")
Person(academic, "Academic Services", "Reviews and approves requisitions from an academic services standpoint.")
Person(finance, "Finance", "Reviews and approves requisitions from a budget/finance standpoint.")
Person(exec_director, "Executive Director", "Reviews and grants final approval on requisitions.")
Person(logistics, "Logistics", "Views approved requisitions and processes requisitions fulfillment/delivery.")

System_Boundary(docupulse, "Requisition Management System (DocuPulse)") {
    Container(web_portal, "Web Portal", "React + Vite, hosted on Vercel", "Single-page application used to submit, track, review, and act on requisitions.")
    Container(requisition_api, "Requisition API", "Node.js, Vercel Serverless Functions", "Handles requisitions, approval workflow, fulfillment and reports, AI routing, and role-based access.")
    Container(auth_service, "Auth Service", "Supabase Auth", "Authentication and role-based access control.")
    Container(notification_service, "Notification Service", "Supabase Realtime / Edge Functions", "Pushes real-time status updates to users.")
    ContainerDb(requisition_db, "Requisition Database", "Supabase (PostgreSQL)", "Requisitions, approval history, statuses, user roles, audit logs.")
}

System_Ext(ai_system, "AI System", "External AI service that analyzes and routes requisitions.")

Rel(requestor, web_portal, "Submits, manages, and tracks requisitions", "HTTPS")
Rel(dept_head, web_portal, "Reviews, endorses, and approves requisitions", "HTTPS")
Rel(academic, web_portal, "Reviews and approves requisitions", "HTTPS")
Rel(finance, web_portal, "Reviews and approves requisitions", "HTTPS")
Rel(exec_director, web_portal, "Reviews and approves requisitions", "HTTPS")
Rel(logistics, web_portal, "Manages reports and processes requisitions", "HTTPS")

Rel(web_portal, requisition_api, "Makes API calls to", "JSON/HTTPS")
Rel(requisition_api, auth_service, "Validates tokens with", "HTTPS")
Rel(requisition_api, requisition_db, "Reads from and writes to", "SQL/TCP")
Rel(requisition_api, notification_service, "Triggers status update events to", "Internal API / Realtime Channel")
Rel(requisition_api, ai_system, "Sends requisitions for analysis and routing", "API Calls")
Rel(notification_service, web_portal, "Pushes real-time status updates to", "Realtime Channel")

@enduml
