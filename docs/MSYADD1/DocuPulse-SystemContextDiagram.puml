@startuml DocuPulse-Context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

Person(requestor, "Requestor", "Creates and manages requisitions, and receives notifications of status.")
Person(dept_head, "Department Head", "Reviews, endorses, and approves submitted requisitions.")
Person(exec_director, "Executive Director", "Reviews and grants final approval on requisitions.")
Person(academic, "Academic Services", "Reviews and approves requisitions from an academic services standpoint.")
Person(finance, "Finance", "Reviews and approves requisitions from a budget/finance standpoint.")
Person(logistics, "Logistics", "Views approved requisitions and processes requisitions fulfillment/delivery.")

System(docupulse, "Requisition Management System (DocuPulse)", "Central system for creating, routing, reviewing, approving, tracking, and processing requisitions.")

System_Ext(ai_system, "AI System", "External AI service that analyzes requisitions and routes them to the appropriate approver.")

Rel(requestor, docupulse, "Submits, manages, and tracks requisitions", "Web Portal / HTTPS")
Rel(dept_head, docupulse, "Reviews, endorses and approves requisitions", "Web Portal / HTTPS")
Rel(exec_director, docupulse, "Reviews and approves requisitions", "Web Portal / HTTPS")
Rel(academic, docupulse, "Reviews and approves requisitions", "Web Portal / HTTPS")
Rel(finance, docupulse, "Reviews and approves requisitions", "Web Portal / HTTPS")
Rel(logistics, docupulse, "Manages reports and processes requisitions", "Web Portal / HTTPS")

Rel(docupulse, ai_system, "Sends requisitions for AI analysis and routing", "API Calls")

@enduml